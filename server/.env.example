# --- Core ---
NODE_ENV=development
PORT=4000

# SQLite by default. For Postgres set e.g. postgresql://user:pass@host:5432/db
# and change the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Twilio (optional) ---
# When unset, verification/invite SMS are logged to the console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stripe (optional) ---
# When unset, subscriptions run in a local "mock" mode and activate instantly.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=homegame://subscription/success
STRIPE_CANCEL_URL=homegame://subscription/cancel
