# Copy this file to .env and adjust values.

# Port the API server listens on
PORT=4000

# JWT signing secret. Use a long random string in production.
JWT_SECRET=change-me-in-production

# Development helper: when true, verify-otp accepts the code "000000" for any phone,
# and request-otp echoes the generated code in its response so you can log in without
# an SMS provider configured.
DEV_MODE=true

# --- Stripe ---
# Leave STRIPE_SECRET_KEY blank to run the app without live payments; the API will
# treat any authenticated host as subscribed while unset. Set it to enable real
# Stripe Checkout for the host subscription.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# URL the mobile app is expected to open after Checkout success/cancel.
STRIPE_SUCCESS_URL=homegame://subscription/success
STRIPE_CANCEL_URL=homegame://subscription/cancel

# --- SMS provider (optional) ---
# The default implementation only logs OTP codes to the console. Wire your own
# provider (e.g. Twilio) in src/lib/sms.js when ready.
