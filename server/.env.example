# Server configuration
PORT=4000
NODE_ENV=development

# JWT secret used to sign auth tokens. Change this in production.
JWT_SECRET=change-me-in-production

# Path to the SQLite database file (relative to the server directory).
DATABASE_PATH=./data/home-game.db

# --- SMS delivery (Twilio) ---
# When these are set, real SMS messages are sent for OTP codes and invitations.
# When they are empty, the app runs in "dev mode" and prints codes to the server
# log and returns them in the API response so you can test without a phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Subscriptions (Stripe) ---
# When STRIPE_SECRET_KEY is set, hosts are sent to a real Stripe Checkout session.
# When it is empty, the app runs in "dev mode" and subscriptions activate instantly.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Price shown in the app (informational, in the smallest currency unit is not used here)
SUBSCRIPTION_PRICE_LABEL=$9.99 / month

# Public base URL clients use to build invite deep links
PUBLIC_APP_URL=homegame://
